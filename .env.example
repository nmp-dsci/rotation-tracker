# Copy to .env and fill from: make -C ../nmp-central-ai db-urls (the P11 rotation block)
ROTATION_ADMIN_DATABASE_URL=
ROTATION_DATABASE_URL=
ROTATION_RO_DATABASE_URL=
MLFLOW_TRACKING_URI=http://localhost:5000
# Supadata keys are read from ~/.env (SUPADATA_API_KEY, SUPADATA_API_KEY_2, ...)

# s03: market-getdata's prices over postgres_fdw (`rt db migrate` imports its staging as
# market_staging). Leave all unset to run without prices. Defaults: localhost (the container's own
# loopback; `postgres` from a compose stack), 5432, market, market_ro, password = the user.
# MARKET_FDW_HOST=localhost
# MARKET_FDW_PORT=5432
# MARKET_FDW_DBNAME=market
# MARKET_RO_USER=market_ro
# MARKET_RO_PASSWORD=
